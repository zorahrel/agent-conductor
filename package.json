{
  "name": "agent-conductor",
  "version": "0.5.0",
  "description": "Pilot N concurrent AI coding agent CLI sessions from one place. JSONL transcript reader, deterministic status deriver, cwd-collision lock, tmux send-keys controller with audit log, macOS Reminders intent layer, and a `agent-conductor` CLI binary for terminal-driven workflows. Claude Code today, pluggable for Aider / Cursor CLI / others.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agent-conductor": "./dist/cli/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./jsonl": {
      "types": "./dist/jsonl/index.d.ts",
      "import": "./dist/jsonl/index.js",
      "require": "./dist/jsonl/index.cjs"
    },
    "./sessions": {
      "types": "./dist/sessions/index.d.ts",
      "import": "./dist/sessions/index.js",
      "require": "./dist/sessions/index.cjs"
    },
    "./tmux": {
      "types": "./dist/tmux/index.d.ts",
      "import": "./dist/tmux/index.js",
      "require": "./dist/tmux/index.cjs"
    },
    "./reminders": {
      "types": "./dist/reminders/index.d.ts",
      "import": "./dist/reminders/index.js",
      "require": "./dist/reminders/index.cjs"
    },
    "./discovery": {
      "types": "./dist/discovery/index.d.ts",
      "import": "./dist/discovery/index.js",
      "require": "./dist/discovery/index.cjs"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js",
      "require": "./dist/providers/index.cjs"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js",
      "require": "./dist/mcp/index.cjs"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "import": "./dist/http/index.js",
      "require": "./dist/http/index.cjs"
    },
    "./timeseries": {
      "types": "./dist/timeseries/index.d.ts",
      "import": "./dist/timeseries/index.js",
      "require": "./dist/timeseries/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test 'src/**/*.spec.ts'",
    "test:once": "tsx --test 'src/**/*.spec.ts' --test-reporter spec",
    "test:cli": "bash tests/cli.bats.sh",
    "test:backcompat": "npm run build && node examples/v04-backcompat.mjs",
    "test:all": "npm test && npm run test:cli && npm run test:backcompat",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "claude-code",
    "ai-agent",
    "cli-orchestration",
    "cli",
    "terminal",
    "tmux",
    "session-management",
    "transcript-parser",
    "apple-reminders",
    "agent-coordinator",
    "multi-session",
    "macos",
    "aider",
    "cursor"
  ],
  "author": "zorahrel",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.18.1",
    "tsup": "^8.3.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zorahrel/agent-conductor.git"
  },
  "bugs": {
    "url": "https://github.com/zorahrel/agent-conductor/issues"
  },
  "homepage": "https://github.com/zorahrel/agent-conductor#readme",
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "ws": "^8.20.0"
  }
}
